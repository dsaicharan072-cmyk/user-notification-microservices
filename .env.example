# API Gateway
GATEWAY_PORT=3000
JWT_SECRET=replace-with-a-32-character-minimum-secret
USER_SERVICE_URL=http://user-service:3001

# User Service
USER_SERVICE_PORT=3001
USER_DATABASE_URL=postgresql://app:app@postgres:5432/users

# Notification Service
NOTIFICATION_DATABASE_URL=postgresql://app:app@postgres:5432/notifications

# NATS: use NATS_CREDS_FILE in production instead of user/password.
NATS_URL=nats://nats:4222
NATS_USER=app
NATS_PASSWORD=change-me
# NATS_CREDS_FILE=/run/secrets/app.creds
# NATS_TLS_CA=/run/secrets/nats-ca.pem
